# From developer.apple.com
PASS_TYPE_ID=pass.com.example.idwallet
TEAM_ID=XXXXXXXXXX
ORGANIZATION_NAME=Your Name

# Local dev: PEM files written by scripts/setup-certs.sh (defaults to ./certs/*.pem)
# Deploy (e.g. Vercel): set these to base64 of each PEM instead
# PASS_SIGNER_CERT_B64=
# PASS_SIGNER_KEY_B64=
# PASS_WWDR_B64=

# Base URL for "Show large QR" links on passes (defaults to the request origin)
# PUBLIC_URL=https://your-domain
